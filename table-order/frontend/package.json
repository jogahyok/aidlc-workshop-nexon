{
  "name": "table-order-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:customer": "pnpm --filter customer-app dev",
    "dev:admin": "pnpm --filter admin-app dev",
    "build": "pnpm -r build",
    "build:customer": "pnpm --filter customer-app build",
    "build:admin": "pnpm --filter admin-app build",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}' --max-warnings 0",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}'",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
